<mujoco model="balancing_bot">
  <compiler angle="radian" meshdir="../meshes" inertiafromgeom="false" autolimits="true" />
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81" />

  <default>
    <joint damping="0.05" />
    <geom friction="1.0 0.005 0.0001" condim="3" />
  </default>

  <asset>
    <texture name="ground_checker" type="2d" builtin="checker" width="512" height="512"
      rgb1="0.82 0.84 0.86" rgb2="0.62 0.66 0.7" />
    <material name="ground_material" texture="ground_checker" texuniform="true"
      texrepeat="4 4" reflectance="0.15" />
    <mesh name="base_mesh" file="base_link.STL" />
    <mesh name="left_wheel_mesh" file="left_wheel_link.STL" />
    <mesh name="right_wheel_mesh" file="right_wheel_link.STL" />
  </asset>

  <worldbody>
    <light name="key" pos="0 0 2" dir="0 0 -1" />
    <geom name="ground" type="plane" size="2 2 0.1" material="ground_material" />

    <body name="base_link" pos="0 0 0.11">
      <freejoint name="root" />
      <inertial pos="-0.0049956 0.017918 0.024026" mass="0.47562"
        fullinertia="0.00071578 0.00056287 0.00025839 8.5923e-08 -6.0278e-07 -2.1368e-05" />
      <geom name="base_collision" type="mesh" mesh="base_mesh" rgba="1 0 0 1" />
      <site name="imu_site" pos="-0.0049956 0.017918 0.024026" size="0.008" />

      <body name="left_wheel_link" pos="0.02467 -0.04833 -0.068773">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" limited="false" />
        <inertial pos="-0.00013959 0.12754 -0.00011825" mass="0.09497"
          fullinertia="2.7563e-05 4.9481e-05 2.7727e-05 -2.8178e-10 5.9886e-07 -3.2608e-08" />
        <geom name="left_wheel_collision" type="mesh" mesh="left_wheel_mesh" rgba="0.25 0.25 0.25 1" />
      </body>

      <body name="right_wheel_link" pos="0.024493 0.08427 -0.068728">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" limited="false" />
        <inertial pos="0.0001155 -0.12754 -0.00018209" mass="0.09497"
          fullinertia="2.7568e-05 4.9481e-05 2.7722e-05 2.8058e-10 -5.9888e-07 3.3169e-08" />
        <geom name="right_wheel_collision" type="mesh" mesh="right_wheel_mesh" rgba="0.25 0.25 0.25 1" />
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="left_wheel_link" />
    <exclude body1="base_link" body2="right_wheel_link" />
  </contact>

  <actuator>
    <motor name="left_wheel_motor" joint="left_wheel_joint" ctrllimited="true" ctrlrange="-2 2" />
    <motor name="right_wheel_motor" joint="right_wheel_joint" ctrllimited="true" ctrlrange="-2 2" />
  </actuator>

  <sensor>
    <gyro name="imu_gyro" site="imu_site" />
    <accelerometer name="imu_accel" site="imu_site" />
    <jointpos name="left_wheel_position" joint="left_wheel_joint" />
    <jointvel name="left_wheel_velocity" joint="left_wheel_joint" />
    <jointpos name="right_wheel_position" joint="right_wheel_joint" />
    <jointvel name="right_wheel_velocity" joint="right_wheel_joint" />
  </sensor>
</mujoco>
